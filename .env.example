# ===== AgentFlow 环境变量模板 =====
# 复制为 backend/.env 或直接设置系统环境变量，所有变量前缀为 AGENTFLOW_

# ---------- LLM ----------
# mock = 内置离线模拟模型（无需任何 Key，可跑通全部演示流程）
# openai_compatible = 任何 OpenAI 兼容接口（智谱 / DeepSeek / 通义 / OpenAI 等）
AGENTFLOW_LLM_PROVIDER=mock
AGENTFLOW_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENTFLOW_LLM_API_KEY=
AGENTFLOW_LLM_MODEL=glm-4-flash
AGENTFLOW_LLM_TEMPERATURE=0.7
AGENTFLOW_LLM_MAX_TOKENS=2048

# ---------- Embedding ----------
# local = 内置本地哈希向量（离线可用）；openai_compatible = 调用远程 Embedding API
AGENTFLOW_EMBEDDING_PROVIDER=local
AGENTFLOW_EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENTFLOW_EMBEDDING_API_KEY=
AGENTFLOW_EMBEDDING_MODEL=embedding-3

# ---------- 网关 ----------
AGENTFLOW_AUTH_ENABLED=false
AGENTFLOW_API_KEY=agentflow-dev-key
AGENTFLOW_RATE_LIMIT_PER_MINUTE=60

# ---------- Agent 运行时 ----------
AGENTFLOW_MAX_ITERATIONS=6
AGENTFLOW_MEMORY_WINDOW=10
AGENTFLOW_RAG_TOP_K=4

# ---------- 其他 ----------
# 设为 false 可让 web_search / web_read 直接返回模拟结果（离线演示 / 测试）
AGENTFLOW_NET_TOOLS_ENABLED=true
# 数据目录（默认项目根目录下 data/）
# AGENTFLOW_DATA_DIR=D:/agentflow-data
